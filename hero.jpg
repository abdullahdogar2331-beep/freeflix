<section class="hero">
  <div class="hero-bg"></div>

  <div class="hero-content">
    <span class="hero-kicker">FREEFLIX ORIGINAL EXPERIENCE</span>
    <h1>Stories worth<br><span>staying for.</span></h1>
    <p>
      Discover cinematic stories, timeless films and unforgettable moments.
    </p>

    <div class="hero-actions">
      <a href="#discover" class="btn btn-primary">Explore Movies</a>
      <button class="btn btn-secondary" onclick="randomMovie()">Surprise Me</button>
    </div>
  </div>

  <div class="hero-fade"></div>
</section>
